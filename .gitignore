# ============================================================
# 构建产物
# ============================================================
build/bin/
# Wails 在 Windows 构建时生成的图标资源
*.syso

# Go 编译产物与测试二进制
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
# Go 工作区 / 性能分析产物
go.work
go.work.sum
*.prof
*.pprof

# ============================================================
# 前端
# ============================================================
node_modules/
# 前端构建产物整体忽略，但保留占位文件：
# main.go 用 `//go:embed all:frontend/dist` 嵌入产物，目录必须存在，
# 否则未构建前端时 `go build` / `go run .`（pnpm run dev:app）会直接失败
frontend/dist/*
!frontend/dist/.gitkeep
# Wails 生成的依赖指纹，用于判断是否需要重装依赖
frontend/package.json.md5
# Vite 本地缓存
.vite/
*.local
# TS 增量构建信息与 pnpm 本地存储
*.tsbuildinfo
.pnpm-store/
# wails3 task 的执行缓存
.task/

# ============================================================
# 日志
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# 敏感信息与本地数据
# ============================================================
# 数据库密码加密用的密钥
.secret.key
# SQLite 数据库及其 WAL 文件（正常运行时位于用户配置目录，此处为保险）
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 环境变量
.env
.env.local
.env.*.local

# ============================================================
# 编辑器与系统
# ============================================================
# 忽略 IDE 本地配置，但保留可共享的推荐扩展与设置
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
# Windows
Thumbs.db
desktop.ini

# ============================================================
# 工作区辅助目录
# ============================================================
.codebuddy/
